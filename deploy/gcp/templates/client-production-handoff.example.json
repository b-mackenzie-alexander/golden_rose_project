    "readiness": "<passed-or-not-run>",
    "staff_entry_boundary": "<passed-or-not-run>"
  },
  "recovery": {
    "rollback_or_forward_recovery_note": "<value-safe-recovery-record>",
    "status": "<recorded-or-not-run>"
  },
  "operations": {
    "backup_restore_owner": "<private-owner-record>",
